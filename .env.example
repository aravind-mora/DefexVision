# Copy this file to `.env` and adjust values for your machine.
# DefexVision - configuration

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production (only when DJANGO_DEBUG=False) ---
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False

# --- SQL (Django default). Switch to PostgreSQL in production ---
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=defexvision
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# --- NoSQL (MongoDB) - stores image analysis metadata / preprocessing JSON ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=defexvision

# --- Inference engine ---
# Set INFERENCE_MODE=flask to use the Flask microservice (recommended).
# INFERENCE_MODE=demo  -> runs without a model, for development/preview only.
INFERENCE_MODE=flask
FLASK_API_URL=http://127.0.0.1:5001
# Timeout (seconds) for calling the Flask /predict endpoint. Increase if the
# free-tier inference instance is slow to wake / runs inference slowly.
FLASK_TIMEOUT=180

# Path to the YOLO weights file (e.g. "models/yolo8m (1).pt")
MODEL_PATH=models/yolo8m (1).pt
MODEL_CONF=0.25
MODEL_IOU=0.45

# Optional: direct/Google-Drive/Dropbox link to the model. If set, setup.sh,
# run.sh and download_model.py will fetch the model into models/ automatically
# when MODEL_PATH is missing (so new users don't have to find the file).
# Pre-filled with the project's public model link.
MODEL_URL=https://drive.google.com/file/d/1OdxHVoHfdR44rsSokrHvtu1hLFiyhNEg/view?usp=sharing

# Preprocessing before inference:
#   raw      -> feed the raw image straight to the model (matches the
#               reference script: model(frame1), no crop/enhance/deskew).
#   enhanced -> crop the chip, denoise, CLAHE enhance, deskew, then infer.
PREPROCESS_MODE=raw