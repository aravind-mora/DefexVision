# Copy this file to `.env` and adjust values for your machine.
# DefexVision - configuration

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- SQL (Django default). Switch to PostgreSQL in production ---
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=defexvision
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# --- NoSQL (MongoDB) - stores image analysis metadata / preprocessing JSON ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=defexvision

# --- Inference engine ---
# Set INFERENCE_MODE=flask to use the Flask microservice (recommended).
# INFERENCE_MODE=demo  -> runs without a model, for development/preview only.
INFERENCE_MODE=flask
FLASK_API_URL=http://127.0.0.1:5001

# Path to the YOLO weights file (e.g. "models/yolo8m (1).pt")
MODEL_PATH=models/yolov8m (1).pt
MODEL_CONF=0.25
MODEL_IOU=0.45
